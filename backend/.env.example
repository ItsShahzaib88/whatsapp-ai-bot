# ============================================================
# AI WhatsApp Assistant — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- APPLICATION ----
APP_NAME="AI WhatsApp Assistant"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALLOWED_HOSTS="localhost,127.0.0.1"
FRONTEND_URL="http://localhost:3000"

# ---- DATABASE (MongoDB Atlas Free Tier) ----
MONGODB_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net"
MONGODB_DB_NAME="whatsapp_ai"

# ---- CACHE (Redis) ----
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""

# ---- JWT ----
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ADMIN ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme_strong_password"
ADMIN_NAME="Admin"

# ---- WHATSAPP CLOUD API ----
# Get from: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"
WHATSAPP_ACCESS_TOKEN="your_permanent_access_token"
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"

# ---- AI PROVIDERS ----
# Primary: Google Gemini (Free Tier Available)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash-exp"
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# OpenAI (Fallback 1)
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# Groq (Fallback 2 — Free Tier Available)
# Get from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter (Fallback 3)
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="anthropic/claude-3-haiku"

# Together AI (Fallback 4)
TOGETHER_API_KEY="your_together_api_key"
TOGETHER_MODEL="meta-llama/Llama-3-70b-chat-hf"

# Active AI Provider (gemini | openai | groq | openrouter | together)
ACTIVE_AI_PROVIDER="gemini"
AUTO_FALLBACK_ENABLED=true

# ---- VOICE PROCESSING ----
# Edge TTS (Free, Microsoft) — no key needed
VOICE_ENGINE="edge_tts"
# edge-tts voices: en-US-JennyNeural, ur-PK-AsadNeural, en-US-GuyNeural
DEFAULT_VOICE_EN="en-US-JennyNeural"
DEFAULT_VOICE_UR="ur-PK-AsadNeural"
# Whisper STT via Groq (Free tier)
WHISPER_MODEL="whisper-large-v3"

# ---- WEB SEARCH ----
# DuckDuckGo: No API key needed
SEARCH_ENGINE="duckduckgo"
MAX_SEARCH_RESULTS=5
# Open-Meteo: Free, no key needed
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
GEOCODING_API_URL="https://geocoding-api.open-meteo.com/v1/search"
# NewsAPI free tier
NEWS_API_KEY="your_newsapi_key"
NEWS_API_URL="https://newsdata.io/api/1/news"

# ---- RATE LIMITING ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ---- LOGGING ----
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ---- CELERY (Message Queue) ----
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ---- CORS ----
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ---- FILE STORAGE ----
MEDIA_UPLOAD_DIR="/tmp/whatsapp_media"
MAX_VOICE_SIZE_MB=10
